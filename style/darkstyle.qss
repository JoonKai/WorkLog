QWidget {
    background-color: #404040;
    color: #f0f0f0;
    font-family: '맑은 고딕';
    font-size: 9pt;
}
/*메뉴 스타일#############################################################################################################*/
/* QMainWindow 배경 */
QMainWindow {
    background-color: #404040;
}
/* 메뉴바 */
QMenuBar {
    background-color:#404040;
    color: #f0f0f0;
}

QMenuBar::item {
    background-color: #404040;
    padding: 6px 10px;
}

QMenuBar::item:selected {
    background-color: #404040;
}

/* 메뉴 드롭다운 */
QMenu {
    background-color:#404040;
    color: #f0f0f0;
    border: 1px solid #444;
}
QMenu::item:selected {
    background-color: #404040
}
/*메뉴 스타일#############################################################################################################*/


/*버튼 스타일#############################################################################################################*/
/* 버튼 */
QPushButton {
    background-color: #3a3a3a;
    color: white;
    border: 1px solid #555;
    padding: 6px 12px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #4d4d4d;
}
/*버튼 스타일#############################################################################################################*/


/*라벨 스타일#############################################################################################################*/
QLabel#mylabel{
    color: #f0f0f0;
    background-color: transparent;
}
/*라벨 스타일#############################################################################################################*/


/*프레임 스타일#############################################################################################################*/
QFrame {
    background-color: #333333;
    border: 1px solid #555;
    border-radius: 6px;
}
/*프레임 스타일#############################################################################################################*/


/*텍스타박스 스타일#############################################################################################################*/
QLineEdit, QTextEdit {
    background-color: #3a3a3a;
    color: white;
    border: 1px solid #666;
    padding: 4px;
}
/*텍스트박스 스타일#############################################################################################################*/


/*테이블 스타일#############################################################################################################*/
/*mocvdTable에만 적용용*/
QTableWidget#mocvdTable {
    background-color: #2b2b2b;
    color: #f0f0f0;
    gridline-color: #3c3c3c;
    selection-background-color: #555555;  /* ✅ 드래그 선택 시 어두운 그레이 */
    selection-color: #ffffff;
    border: 1px solid #3c3c3c;
    font-size: 13px;
    alternate-background-color: #353535;
}

QHeaderView#mocvdTable::section {
    background-color: #3c3f41;
    color: #f0f0f0;
    padding: 56pxpx;
    border: 1px solid #444444;
    font-weight: bold;
}

QTableWidget#mocvdTable::item {
    border: none;
    padding: 2px;
}

QTableWidget#mocvdTable::item:selected {
    background-color: #444444;  /* ✅ 선택 시 어두운 그레이 */
    color: white;
}

QTableCornerButton#mocvdTable::section {
    background-color: #3c3f41;
    border: 1px solid #444444;
}
/*테이블 스타일#############################################################################################################*/




/*탭컨트롤 스타일#############################################################################################################*/
/* 탭 전체 배경 */
QTabWidget::pane {
    border: 1px solid #000000;  /* 변경됨 */
    background: #2e2e2e;
}

/* 탭 바 배경 */
QTabBar {
    background-color: #2b2b2b;
}

/* 탭 항목 (기본 상태) */
QTabBar::tab {
    background: rgb(27, 27, 27);
    color: #ccc;
    padding: 3px 8px;
    border: 1px solid #000000;  /* 변경됨 */
    border-bottom: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    margin-right: 0px;
}

/* 탭 항목 (선택된 상태) */
QTabBar::tab:selected {
    background: #4d4d4d;
    color: #fff;
    border-bottom: 5px solid #E36C74;  /* 선택 강조 테두리는 유지 */
    border-left: 1px solid #000000;    /* 추가: 좌우 테두리 유지 */
    border-right: 1px solid #000000;
}
/* 마우스 호버 */
QTabBar::tab:hover {
    background: #505050;
}
/*탭컨트롤 스타일#############################################################################################################*/



/*스크롤바 스타일#############################################################################################################*/
/* 수직 스크롤바 */
QScrollBar:vertical {
    background: #2b2b2b;
    width: 6px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #E36C74;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #E36C74;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}
/* 수평 스크롤바 */
QScrollBar:horizontal {
    background: #2b2b2b;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #E36C74;
    border-radius: 3px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background:rgb(236, 138, 145);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    background: none;
    width: 0px;
}

/* 스크롤바 트랙 여백 */
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}
QSizeGrip {
    image: none; /* 그림 없애기 (또는 대체 이미지 설정) */
    width: 12px;
    height: 12px;
    margin: 0px 4px 4px 0px; /* 위치 미세 조정 */
    background: transparent; /* 배경 투명 */
}
/*스크롤바 스타일#############################################################################################################*/


/*스플리터 스타일#############################################################################################################*/
QSplitter {
    background-color: #E36C74;
    margin: 5px
}

/* 가로 splitter의 핸들 (중간 드래그 바) */
QSplitter::handle:horizontal {
    background-color: #E36C74;
    height: 30px;  /* 수평 splitter는 높이로 설정 */
}

/* 세로 splitter의 핸들 (중간 드래그 바) */
QSplitter::handle:vertical {
    background-color: #E36C74;
    width: 30px;  /* 수직 splitter는 너비로 설정 */
}

/* 드래그 시 하이라이트 */
QSplitter::handle:hover {
    background-color: #E36C74;
}
/*스플리터 스타일#############################################################################################################*/


/*스테이터스바 스타일#############################################################################################################*/
QStatusBar {
    background-color: rgb(27, 27, 27);  /* 배경 색상 */
    color: #ffffff;             /* 글자 색상 */
    border-top: 1px solid #444; /* 상단 테두리 */
}
/*스테이터스바 스타일#############################################################################################################*/


/*캘린더 스타일#############################################################################################################*/
CalendarWidget QToolButton {
  	height: 60px;
  	width: 150px;
  	color: white;
  	font-size: 10px;
  	icon-size: 56px, 56px;
  	background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop: 0 #cccccc, stop: 1 #333333);
}
QCalendarWidget QMenu {
  	width: 150px;
  	left: 20px;
  	color: white;
  	font-size: 10px;
  	background-color: rgb(100, 100, 100);
}
QCalendarWidget QSpinBox {
    width: 70px;
    font-size: 14px;
    color: #e0e0e0;
    background-color: #2b2b2b;
    border: 1px solid #444;
    border-radius: 4px;
    padding-right: 15px; /* 텍스트와 버튼 간격 */
    selection-background-color: #555;
    selection-color: white;
}
/* 위, 아래 버튼 */
QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    width: 14px;
    height: 10px;
    subcontrol-origin: border;
    background-color: #3a3a3a;
    border-left: 1px solid #444;
    padding: 1px;
}
/* hover 효과 */
QCalendarWidget QSpinBox::up-button:hover,
QCalendarWidget QSpinBox::down-button:hover {
    background-color: #505050;
}
/* 화살표 크기만 조정 (기본 Qt 아이콘 사용) */
QCalendarWidget QSpinBox::up-arrow,
QCalendarWidget QSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}
/* header row */
QCalendarWidget QWidget { alternate-background-color: rgb(56, 56, 56); }
   
/* normal days */
QCalendarWidget QAbstractItemView:enabled {
    font-size: 12px;
    color: rgb(255, 255, 255);
    background-color: rgb(64, 64, 64);
    selection-background-color: transparent; /* 배경 투명 */
    selection-color: rgb(255, 230, 0);
}
/* 선택된 아이템 테두리 효과 흉내 */
QCalendarWidget QAbstractItemView:item:selected {
        background-color: rgba(177, 177, 177, 50); /* 연한 하이라이트 */
        border: 2px solid rgb(67, 250, 12);        /* 테두리 강제 지정 */
        outline: none;
}
QCalendarWidget QWidget#qt_calendar_navigationbar
{ 
   background-color: #2b2b2b; 
}
QCalendarWidget QAbstractItemView:disabled 
{ 
   color: rgb(64, 64, 64); 
}
/*캘린더 스타일#############################################################################################################*/

/*콤보박스 스타일#############################################################################################################*/
QComboBox {
    text-align: center;
    alignment: 'AlignCenter';
}

QComboBox QAbstractItemView {
    text-align: center;
}
/*콤보박스 스타일#############################################################################################################*/